# Local development only. Copy to .env; never commit the populated file.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Local PostgreSQL; for Docker site service the hostname is postgres.
DATABASE_URL=postgresql://bam_site:CHANGE_ME@postgres:5432/bam_site
POSTGRES_DB=bam_site
POSTGRES_USER=bam_site
POSTGRES_PASSWORD=CHANGE_ME
# Set true only after configuring Better Auth and trusted OAuth providers.
VITE_AUTH_ENABLED=false
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Federated auth via existing Grok broker (NOT Microsoft Entra directly).
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTHORIZATION_URL=
GROK_TOKEN_URL=
GROK_USERINFO_URL=
# Optional connector integration, only for trusted local development.
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=
# Mission brief outbox. Leave empty to disable email delivery locally.
RESEND_API_KEY=
MISSION_BRIEF_FROM=
MISSION_BRIEF_TO=
MISSION_BRIEF_RATE_SECRET=
MISSION_BRIEF_TRUST_PROXY=
# Existing production Compose proxy network (not needed by nas Compose)
PROXY_NETWORK=proxy
# Optional build controls
DEPLOY_TARGET=
BAM_CHROME_CHANNEL=
